<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/gpslog.preferences_pb" />
        <exclude domain="sharedpref" path="gpslog_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Inclusion allowlist: shared preferences containing credentials are not transferred. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore/gpslog.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
